            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "steps": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "derived",
                  "syncope",
                  "orthographic",
                  "compound",
                  "roman-numeral"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "steps": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
