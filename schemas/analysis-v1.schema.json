    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "steps"
      ],
      "properties": {
        "method": {
          "enum": [
            "regular",
            "derived",
            "unique",
            "syncope",
            "orthographic",
            "compound",
            "roman-numeral",
            "unknown-name"
