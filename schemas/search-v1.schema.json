{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whitaker's WORDS compact Latin search result",
  "description": "Dataset-local search hits without lexical or editorial content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "datasetId",
    "query",
    "status",
    "hits",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "whitakers-words.search"
    },
    "schemaVersion": {
      "const": 1
    },
    "datasetId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "status": {
      "enum": [
        "analyzed",
        "unknown",
        "error"
      ]
    },
    "hits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hit"
      }
    },
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/twoWordsSuggestion"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "analyzed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "hits": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unknown",
              "error"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "hits": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "diagnostics": {
            "minItems": 1,
            "contains": {
              "properties": {
                "severity": {
                  "const": "error"
                }
              },
              "required": [
                "severity"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "suggestions"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "unknown"
          },
          "diagnostics": {
            "contains": {
              "properties": {
                "code": {
                  "const": "two-words-suggestion"
                }
              },
              "required": [
                "code"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "twoWordsSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "splitAt",
        "classification",
        "segments"
      ],
      "properties": {
        "method": {
          "const": "two-words"
        },
        "splitAt": {
          "type": "integer",
          "minimum": 2
        },
        "classification": {
          "enum": [
            "unconstrained",
            "number-pair"
          ]
        },
        "segments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/searchSuggestionSegment"
            },
            {
              "$ref": "#/$defs/searchSuggestionSegment"
            }
          ],
          "items": false
        }
      }
    },
    "searchSuggestionSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "hits"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "hits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hit"
          }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "normalized",
        "mode"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "normalized": {
          "type": "string"
        },
        "mode": {
          "const": "latin"
        }
      }
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lexemeId",
        "ruleId",
        "addonIds",
        "scoreFlags"
      ],
      "properties": {
        "lexemeId": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "ruleId": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "addonIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "scoreFlags": {
          "const": 0
        },
        "artificial": {
          "$ref": "#/$defs/artificialHit"
        },
        "compound": {
          "$ref": "#/$defs/compoundHit"
        },
        "rewriteIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "lexemeId": {
              "type": "integer"
            }
          },
          "required": [
            "lexemeId"
          ],
          "not": {
            "required": [
              "artificial"
            ]
          }
        },
        {
          "properties": {
            "lexemeId": {
              "type": "null"
            },
            "ruleId": {
              "type": "null"
            },
            "addonIds": {
              "type": "array"
            }
          },
          "required": [
            "artificial"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "rewriteIds"
                ]
              },
              {
                "required": [
                  "compound"
                ]
              }
            ]
          }
        }
      ]
    },
    "artificialHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "value",
        "wellFormed"
      ],
      "properties": {
        "method": {
          "const": "roman-numeral"
        },
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "wellFormed": {
          "type": "boolean"
        }
      }
    },
    "compoundHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction",
        "auxiliary"
      ],
      "properties": {
        "construction": {
          "enum": [
            "finite-sum",
            "esse",
            "fuisse",
            "iri"
          ]
        },
        "auxiliary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "parameters"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  }
}
