{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grammar-specialization-v1.schema.json",
  "title": "Words grammar specialization ledger record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "kind",
    "id",
    "compatibility",
    "grammarStatus",
    "claim",
    "implementation",
    "grammar",
    "witnesses"
  ],
  "properties": {
    "schema": {"const": "words.grammar-specialization"},
    "schemaVersion": {"const": 1},
    "kind": {
      "enum": ["code-specialization", "assessment", "rewrite-family"]
    },
    "id": {"type": "string", "minLength": 1},
    "compatibility": {
      "enum": ["differentially-equal", "intentional-difference"]
    },
    "grammarStatus": {
      "enum": ["linguistically-supported", "disputed", "legacy-bug"]
    },
    "claim": {"type": "string", "minLength": 1},
    "implementation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "symbol"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "symbol": {"type": "string", "minLength": 1}
        }
      }
    },
    "grammar": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "locator", "claim"],
        "properties": {
          "authority": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1}
        }
      }
    },
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "expect"],
        "properties": {
          "input": {"type": "string", "minLength": 1},
          "expect": {
            "enum": ["analysis", "compound", "no-compound", "flag"]
          }
        }
      }
    }
  }
}
