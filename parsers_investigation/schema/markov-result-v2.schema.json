{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordswasm.local/schemas/parser-markov-result-v2.json",
  "title": "WordsWASM parser Markov investigation result v2",
  "type": "object",
  "required": [
    "schema", "schemaVersion", "datasetId", "sourceCommit", "compiler",
    "compilerVersion", "buildType", "maxProduct", "parserStrategy",
    "candidatePolicy", "structurePolicy", "trainingCorpus", "supplementalCorpus",
    "attestedCorpus", "trainingWeights", "evaluationPolicy", "evaluationTier",
    "evaluationCoverage",
    "trainingControl", "trainingControlPolicy", "shuffleSeed", "exposureMultipliers",
    "parserCanonicalOrder", "parserCanonicalEncoding", "syntheticRelinearizationPolicy",
    "goldAlternativeWeighting", "silverSelection",
    "tieBreak", "rankingAblation", "configurations"
  ],
  "properties": {
    "schema": {"const": "words-parser-markov-investigation"},
    "schemaVersion": {"const": 2},
    "datasetId": {"type": "string", "minLength": 1},
    "sourceCommit": {"type": "string", "minLength": 1},
    "compiler": {"type": "string", "minLength": 1},
    "compilerVersion": {"type": "string", "minLength": 1},
    "buildType": {"type": "string", "minLength": 1},
    "maxProduct": {"type": "integer", "minimum": 1},
    "parserStrategy": {"const": "dependency-projection"},
    "candidatePolicy": {"type": "string", "minLength": 1},
    "structurePolicy": {"type": "string", "minLength": 1},
    "trainingCorpus": {"type": "string", "minLength": 1},
    "supplementalCorpus": {"type": "string", "minLength": 1},
    "attestedCorpus": {"type": "string", "minLength": 1},
    "trainingWeights": {
      "type": "object",
      "required": ["verifiedGold", "attestedGold", "treebankGold", "syntheticGold", "preferredLemmaSilver", "syntheticRelinearization"],
      "properties": {
        "verifiedGold": {"const": 1.0},
        "attestedGold": {"type": "number", "minimum": 0},
        "treebankGold": {"type": "number", "minimum": 0},
        "syntheticGold": {"type": "number", "minimum": 0},
        "preferredLemmaSilver": {"type": "number", "minimum": 0},
        "syntheticRelinearization": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "evaluationPolicy": {"enum": ["leave-one-fixture-out", "in-sample", "exposure-curve"]},
    "evaluationTier": {"enum": ["verified", "attested", "treebank", "all"]},
    "evaluationCoverage": {
      "type": "object",
      "required": ["requestedGoldFixtures", "lexicalCoverage", "withinBudget", "parserOk", "nonemptyNBest", "goldInLattice", "goldSurvivesConstraints", "rankable", "parserStatusCounts"],
      "properties": {
        "requestedGoldFixtures": {"type": "integer", "minimum": 0},
        "lexicalCoverage": {"type": "integer", "minimum": 0},
        "withinBudget": {"type": "integer", "minimum": 0},
        "parserOk": {"type": "integer", "minimum": 0},
        "nonemptyNBest": {"type": "integer", "minimum": 0},
        "goldInLattice": {"type": "integer", "minimum": 0},
        "goldSurvivesConstraints": {"type": "integer", "minimum": 0},
        "rankable": {"type": "integer", "minimum": 0},
        "parserStatusCounts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "trainingControl": {"enum": ["observed", "shuffle-within-sequence", "counterfactual-analysis"]},
    "trainingControlPolicy": {"type": "string", "minLength": 1},
    "shuffleSeed": {"type": "integer", "minimum": 1},
    "exposureMultipliers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "minimum": 0}
    },
    "parserCanonicalOrder": {"type": "string", "minLength": 1},
    "parserCanonicalEncoding": {"type": "string", "minLength": 1},
    "syntheticRelinearizationPolicy": {"type": "string", "minLength": 1},
    "goldAlternativeWeighting": {"type": "string", "minLength": 1},
    "silverSelection": {"type": "string", "minLength": 1},
    "tieBreak": {"const": "manual-score-then-assignment-id"},
    "rankingAblation": {"type": "string", "minLength": 1},
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order", "stateProjection", "linearization", "surfaceWeight",
          "parserCanonicalWeight", "targetExposureMultiplier", "smoothing",
          "summary", "fixtures"
        ],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "stateProjection": {"enum": ["part", "part+morphology"]},
          "linearization": {"enum": ["surface", "hybrid", "parser-canonical"]},
          "surfaceWeight": {"type": "number", "minimum": 0, "maximum": 1},
          "parserCanonicalWeight": {"type": "number", "minimum": 0, "maximum": 1},
          "targetExposureMultiplier": {"type": "number", "minimum": 0},
          "smoothing": {
            "type": "object",
            "required": ["kind", "alpha", "backoffStrength"],
            "properties": {
              "kind": {"enum": ["additive", "hierarchical-backoff"]},
              "alpha": {"type": "number", "exclusiveMinimum": 0},
              "backoffStrength": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          },
          "summary": {
            "type": "object",
            "required": [
              "evaluated", "manualTop1", "markovTop1", "markovTop3",
              "markovBestScoreTies", "markovStrictTop1", "markovMRR",
              "rankingAblation", "scoringDiagnostics"
            ],
            "properties": {
              "evaluated": {"type": "integer", "minimum": 0},
              "manualTop1": {"type": "integer", "minimum": 0},
              "markovTop1": {"type": "integer", "minimum": 0},
              "markovTop3": {"type": "integer", "minimum": 0},
              "markovBestScoreTies": {"type": "integer", "minimum": 0},
              "markovStrictTop1": {"type": "integer", "minimum": 0},
              "markovMRR": {"type": "number", "minimum": 0, "maximum": 1},
              "scoringDiagnostics": {
                "type": "object",
                "required": ["surface", "parserCanonical"],
                "properties": {
                  "surface": {"$ref": "#/$defs/markovDiagnostics"},
                  "parserCanonical": {"$ref": "#/$defs/markovDiagnostics"}
                },
                "additionalProperties": false
              },
              "rankingAblation": {
                "type": "object",
                "required": ["manualOnly", "markovOnly", "markovThenManual"],
                "properties": {
                  "manualOnly": {"$ref": "#/$defs/rankingMetrics"},
                  "markovOnly": {"$ref": "#/$defs/rankingMetricsWithTieBreak"},
                  "markovThenManual": {"$ref": "#/$defs/rankingMetricsWithTieBreak"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "fixtures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fixtureId", "text", "parserCandidates", "trainingPhrases",
                "trainingSequences", "syntheticRelinearizationSequences",
                "trainingControlSkippedPhrases",
                "trainingPhrasesByTier",
                "manualGoldRank", "markovOnlyGoldRank",
                "markovThenManualGoldRank", "markovGoldRank",
                "markovGoldBestScoreTie", "topScoreCandidates",
                "topScoreGoldCandidates", "markovStrictTop1",
                "markovOnlyTopAssignmentId", "markovThenManualTopAssignmentId",
                "topAssignmentId", "topSurfaceStates",
                "topParserOrderedStates", "topSurfaceLogScore",
                "topParserOrderedLogScore", "topMarkovLogScore", "topManualScore",
                "topSurfaceDiagnostics", "topParserOrderedDiagnostics"
              ],
              "properties": {
                "fixtureId": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "parserCandidates": {"type": "integer", "minimum": 1},
                "trainingPhrases": {"type": "integer", "minimum": 1},
                "trainingSequences": {"type": "integer", "minimum": 1},
                "syntheticRelinearizationSequences": {"type": "integer", "minimum": 0},
                "trainingControlSkippedPhrases": {"type": "integer", "minimum": 0},
                "trainingPhrasesByTier": {
                  "type": "object",
                  "properties": {
                    "verifiedGold": {"type": "integer", "minimum": 0},
                    "attestedGold": {"type": "integer", "minimum": 0},
                    "treebankGold": {"type": "integer", "minimum": 0},
                    "syntheticGold": {"type": "integer", "minimum": 0},
                    "preferredLemmaSilver": {"type": "integer", "minimum": 0}
                  },
                  "additionalProperties": false
                },
                "manualGoldRank": {"type": ["integer", "null"], "minimum": 1},
                "markovOnlyGoldRank": {"type": "integer", "minimum": 1},
                "markovThenManualGoldRank": {"type": "integer", "minimum": 1},
                "markovGoldRank": {"type": "integer", "minimum": 1},
                "markovGoldBestScoreTie": {"type": "boolean"},
                "topScoreCandidates": {"type": "integer", "minimum": 1},
                "topScoreGoldCandidates": {"type": "integer", "minimum": 0},
                "markovStrictTop1": {"type": "boolean"},
                "markovOnlyTopAssignmentId": {"type": "string", "minLength": 1},
                "markovThenManualTopAssignmentId": {"type": "string", "minLength": 1},
                "topAssignmentId": {"type": "string", "minLength": 1},
                "topSurfaceStates": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "topParserOrderedStates": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "topSurfaceLogScore": {"type": "number"},
                "topParserOrderedLogScore": {"type": "number"},
                "topMarkovLogScore": {"type": "number"},
                "topManualScore": {"type": "number"},
                "topSurfaceDiagnostics": {"$ref": "#/$defs/markovDiagnostics"},
                "topParserOrderedDiagnostics": {"$ref": "#/$defs/markovDiagnostics"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "markovDiagnostics": {
      "type": "object",
      "required": ["transitions", "unknownStates", "fullContextHits", "fullContextMisses", "uniformFallbacks", "backedOffTransitions", "noObservedContext", "deepestObservedContextHits"],
      "properties": {
        "transitions": {"type": "integer", "minimum": 0},
        "unknownStates": {"type": "integer", "minimum": 0},
        "fullContextHits": {"type": "integer", "minimum": 0},
        "fullContextMisses": {"type": "integer", "minimum": 0},
        "uniformFallbacks": {"type": "integer", "minimum": 0},
        "backedOffTransitions": {"type": "integer", "minimum": 0},
        "noObservedContext": {"type": "integer", "minimum": 0},
        "deepestObservedContextHits": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "rankingMetrics": {
      "type": "object",
      "required": ["top1", "top3", "mrr"],
      "properties": {
        "top1": {"type": "integer", "minimum": 0},
        "top3": {"type": "integer", "minimum": 0},
        "mrr": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "rankingMetricsWithTieBreak": {
      "type": "object",
      "required": ["top1", "top3", "mrr", "tieBreak"],
      "properties": {
        "top1": {"type": "integer", "minimum": 0},
        "top3": {"type": "integer", "minimum": 0},
        "mrr": {"type": "number", "minimum": 0, "maximum": 1},
        "tieBreak": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
