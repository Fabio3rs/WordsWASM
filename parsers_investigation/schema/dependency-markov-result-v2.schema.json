{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordswasm.local/schemas/dependency-markov-result-v2.json",
  "title": "WordsWASM dependency Markov reranking result v2",
  "type": "object",
  "required": [
    "schema", "schemaVersion", "datasetId", "sourceCommit", "compiler",
    "compilerVersion", "buildType", "analysisProfile", "parserStrategy",
    "candidatePolicy", "trainingPolicy", "evaluationPolicy", "evaluationTier",
    "rootConvention", "factorization", "predicateProfileFactor",
    "orderOneContext", "orderTwoContext", "trainingWeights", "alpha",
    "backoffStrength", "maxProduct", "configurations"
  ],
  "properties": {
    "schema": {"const": "words-parser-dependency-markov-investigation"},
    "schemaVersion": {"const": 2},
    "datasetId": {"type": "string", "minLength": 1},
    "sourceCommit": {"type": "string", "minLength": 1},
    "analysisProfile": {"$ref": "#/$defs/analysisProfile"},
    "parserStrategy": {"const": "dependency-tree-oracle"},
    "evaluationPolicy": {"enum": ["leave-one-fixture-out", "in-sample"]},
    "evaluationTier": {"const": "verified-didactic"},
    "configurations": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "$defs": {
    "analysisProfile": {
      "type": "object",
      "required": ["whitakerTrim", "orthography", "twoWords", "mechanisms"],
      "properties": {
        "whitakerTrim": {"enum": ["annotate", "filter"]},
        "orthography": {"enum": ["disabled", "classical-only", "classical-and-medieval"]},
        "twoWords": {"enum": ["disabled", "legacy-first-match"]},
        "mechanisms": {
          "type": "object",
          "required": ["productiveDerivations", "prefixes", "suffixes", "tickons", "tackons", "packons", "syncope", "verbalCompounds"],
          "additionalProperties": {"type": "boolean"}
        }
      },
      "additionalProperties": false
    }
  }
}
