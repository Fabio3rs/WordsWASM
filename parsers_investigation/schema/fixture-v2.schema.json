{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordswasm.local/schemas/parser-fixture-v2.json",
  "title": "WordsWASM parser fixtures v2",
  "type": "object",
  "required": ["schema", "schemaVersion", "fixtures"],
  "properties": {
    "schema": {"const": "words-parser-fixtures"},
    "schemaVersion": {"const": 2},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "phenomenon", "mode"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "phenomenon": {"type": "string", "minLength": 1},
          "mode": {"enum": ["complete-clause", "fragment"]},
          "preferredLemmaSequence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "lookupOverrides": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["token", "lookup", "reason"],
              "properties": {
                "token": {"type": "integer", "minimum": 0},
                "lookup": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "annotation": {
            "type": "object",
            "required": ["status", "source", "evidence"],
            "properties": {
              "status": {"enum": ["verified-didactic"]},
              "source": {
                "type": "object",
                "required": ["catalogId", "title", "repository", "commit", "unitId", "blockId", "printedPage", "sourceText"],
                "properties": {
                  "catalogId": {"type": "string", "minLength": 1},
                  "title": {"type": "string", "minLength": 1},
                  "repository": {"type": "string", "minLength": 1},
                  "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "unitId": {"type": "string", "minLength": 1},
                  "blockId": {"type": "string", "minLength": 1},
                  "printedPage": {"type": "string", "minLength": 1},
                  "sourceText": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              },
              "evidence": {
                "type": "object",
                "required": ["claimBlockId", "claim", "sourceAsserts", "editorialAdds", "reviewedOn"],
                "properties": {
                  "claimBlockId": {"type": "string", "minLength": 1},
                  "claim": {"type": "string", "minLength": 1},
                  "sourceAsserts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "editorialAdds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "reviewedOn": {"type": "string", "format": "date"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "gold": {
            "type": "object",
            "properties": {
              "morphology": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["token", "alternatives"],
                  "properties": {
                    "token": {"type": "integer", "minimum": 0},
                    "alternatives": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "properties": {
                          "lemma": {"type": "string"},
                          "part": {"type": "string"},
                          "case": {"type": "string"},
                          "governs": {"type": "string"},
                          "number": {"type": "string"},
                          "gender": {"type": "string"},
                          "degree": {"type": "string"},
                          "tense": {"type": "string"},
                          "voice": {"type": "string"},
                          "mood": {"type": "string"},
                          "person": {"type": "integer", "minimum": 1, "maximum": 3}
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["relations"],
                  "properties": {
                    "relations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["dependent", "head", "label"],
                        "properties": {
                          "dependent": {"type": "integer", "minimum": 0},
                          "head": {"type": ["integer", "null"], "minimum": 0},
                          "label": {"type": "string", "minLength": 1}
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
